# Local / Compose
APP_ENV=development
VITE_API_BASE_URL=/api
DEVICE=cpu
MODEL_SOURCE=local
MODEL_CHECKPOINT_PATH=/app/checkpoints/best_efficientnetb0.pth
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# AWS (used by GitHub Actions + Terraform; never commit real secrets)
AWS_REGION=ap-south-1
ENVIRONMENT=production
GITHUB_ORG=pcabdur
GITHUB_REPO=WDC-Cerebra
GITHUB_BRANCH=main

# Optional HTTPS — leave empty for HTTP-only learning deploys
ACM_CERTIFICATE_ARN=
